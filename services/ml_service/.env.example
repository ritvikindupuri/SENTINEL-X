# Python ML Service Environment Variables

# Socket.IO Authentication Token (must match frontend NEXT_PUBLIC_SOCKETIO_AUTH_TOKEN)
# Generate a secure random token: openssl rand -hex 32
SOCKETIO_AUTH_TOKEN=your-secure-token-here

# CORS Allowed Origins (comma-separated list)
# For development: http://localhost:3000
# For production: https://your-production-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
